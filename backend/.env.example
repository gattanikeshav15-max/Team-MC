# ==============================================================================
# SiliconSentinel Backend Configuration (Environment Variables)
# ==============================================================================

# Server Network Configuration
PORT=5000
NODE_ENV=development

# ------------------------------------------------------------------------------
# 1. MongoDB Atlas Connection URI
# ------------------------------------------------------------------------------
# Format: mongodb+srv://<username>:<password>@<cluster-url>/silicon_sentinel?retryWrites=true&w=majority
# Replace with your actual MongoDB Atlas cluster connection string.
# If left blank or uncontactable, the server automatically enters DEMO / DEV FALLBACK mode.
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.example.mongodb.net/silicon_sentinel?retryWrites=true&w=majority

# Atlas Vector Search Index Name (Must match index created in Atlas UI)
MONGODB_VECTOR_INDEX=vector_index_memories

# ------------------------------------------------------------------------------
# 2. Google Gemini API Key
# ------------------------------------------------------------------------------
# Get your API key from Google AI Studio (https://aistudio.google.com/)
# Used by VAJRA for Agentic Memory Extraction, Incident Analysis, and Semantic Synthesis.
# If omitted, VAJRA utilizes the built-in deterministic heuristic synthesis engine.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-1.5-flash

# Vector Embedding Configuration (Atlas Vector Search dimensions)
EMBEDDING_DIMENSION=768

# ------------------------------------------------------------------------------
# 3. Security & Authentication
# ------------------------------------------------------------------------------
JWT_SECRET=silicon_sentinel_super_secret_jwt_key_2026_defense_tech
JWT_EXPIRES_IN=7d

# CORS Allowed Origin
CLIENT_ORIGIN=http://localhost:5173

